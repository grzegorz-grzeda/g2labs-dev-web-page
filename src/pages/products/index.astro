---
import { products } from "../../data/company";
import BaseLayout from "../../layouts/BaseLayout.astro";

const productScreenshotMap = {
    nodbeat: {
        src: "/nodbeat.png",
        alt: "nodbeat landing page with the heartbeat monitoring dashboard",
        width: 1600,
        height: 1000,
        frameClass: "product-screenshot-frame-compact",
    },
    vt100logging: {
        src: "/vt100logging.png",
        alt: "vt100logging terminal screenshot",
        width: 605,
        height: 86,
        frameClass: "product-screenshot-frame-compact",
    },
    devtoolsforme: {
        src: "/devtoolsforme.png",
        alt: "DevToolsForMe homepage screenshot",
        width: 1920,
        height: 1459,
        frameClass: "product-screenshot-frame-compact",
    },
    micros: {
        src: "/microsproject.png",
        alt: "MicrOS website screenshot",
        width: 2978,
        height: 1675,
        frameClass:
            "product-screenshot-frame-compact product-screenshot-frame-micros-compact",
    },
    knowledgebase: {
        src: "/knowledgebase.png",
        alt: "G2Labs Knowledge Base resource catalog",
        width: 1440,
        height: 1200,
        frameClass: "product-screenshot-frame-compact",
    },
} as const;
---

<BaseLayout
    title="Products | G2Labs"
    description="Selected products by G2Labs: the nodbeat self-hosted heartbeat monitoring service, browser-side developer tooling, and the MicrOS open-source embedded operating system."
>
    <section class="page-intro panel">
        <p class="eyebrow">Products</p>
        <h1>Product work that makes the engineering taste visible.</h1>
        <p class="lead">
            Things I build and run in public: a self-hosted monitoring service
            for jobs and devices, practical tools for engineers, and clear,
            low-level embedded systems work.
        </p>
    </section>

    <section>
        <div
            class="project-grid work-grid product-row-list product-row-list-catalog"
        >
        {
            products.map((product) => {
                const screenshot =
                    productScreenshotMap[
                        product.slug as keyof typeof productScreenshotMap
                    ];
                const secondaryHref =
                    "repo" in product && product.repo
                        ? product.repo
                        : product.href;
                const secondaryLabel =
                    "repo" in product && product.repo
                        ? "Open repository"
                        : "Open live project";

                return (
                    <article class="project-card tall-card product-row-card product-row-card-catalog">
                        {screenshot && (
                            <figure
                                class={`product-screenshot-frame ${screenshot.frameClass}`}
                            >
                                <img
                                    src={screenshot.src}
                                    alt={screenshot.alt}
                                    loading="lazy"
                                    width={screenshot.width}
                                    height={screenshot.height}
                                />
                            </figure>
                        )}
                        <div class="product-row-content product-row-content-catalog">
                            <p class="card-kicker">{product.label}</p>
                            <h2>{product.name}</h2>
                            <p>{product.summary}</p>
                            <p class="service-outcome">{product.story}</p>
                            <div class="tag-row stack-tags">
                                {product.categories
                                    .slice(0, 5)
                                    .map((category) => (
                                        <span>{category}</span>
                                    ))}
                            </div>
                            <div class="product-links">
                                <a
                                    class="button button-primary"
                                    href={`/products/${product.slug}`}
                                >
                                    View product page
                                </a>
                                <a
                                    class="button button-secondary"
                                    href={secondaryHref}
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    {secondaryLabel}
                                </a>
                            </div>
                        </div>
                    </article>
                );
            })
        }
        </div>
    </section>
</BaseLayout>
