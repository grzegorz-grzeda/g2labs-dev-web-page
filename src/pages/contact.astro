---
import { business, company, links, services, stackAreas } from "../data/company";
import { herotofuEndpoint, isFormConfigured, thankYouPath } from "../lib/forms";
import BaseLayout from "../layouts/BaseLayout.astro";

const serviceOptions = [...services.map((service) => service.title), "Other"];
const productStageOptions = [
    "Discovery",
    "Prototype",
    "Pilot",
    "Production",
    "Stabilization",
    "Rescue",
    "Other",
];
---

<BaseLayout
    title="Contact | G2Labs"
    description="Contact G2Labs to discuss embedded systems, connected software, and product delivery support."
>
    <section class="page-intro panel">
        <p class="eyebrow">Contact</p>
        <h1>Let’s talk about your device.</h1>
        <p class="lead">{company.contactIntro}</p>
        <p class="lead">
            <a class="contact-email" href={`mailto:${company.email}`}
                >{company.email}</a
            >
        </p>
    </section>

    <section class="contact-grid">
        <div class="panel panel-shell">
            <p class="eyebrow">How it works</p>
            <h2>Start with one concrete problem.</h2>
            <p>
                Most engagements start with a concrete problem: firmware
                delivery, wireless integration, MVP scope for a connected
                product, or utility software that sits around the device and
                makes the whole system usable.
            </p>
            <p>
                A useful first message includes the product stage, hardware or
                software stack, the current bottleneck, and what outcome would
                make the engagement worthwhile.
            </p>
        </div>

        <div class="contact-links">
            {
                links.map((link) => (
                    <a href={link.href} target="_blank" rel="noreferrer">
                        <span>{link.label}</span>
                        <span>
                            {link.label === "CEIDG registry"
                                ? "Open registry entry"
                                : "Open profile"}
                        </span>
                    </a>
                ))
            }
        </div>
    </section>

    <section class="panel panel-shell">
        <div class="section-heading compact-heading">
            <div>
                <p class="eyebrow">Inquiry form</p>
                <h2>Send an inquiry</h2>
            </div>
        </div>

        <form
            class="contact-form"
            method="POST"
            action={isFormConfigured ? herotofuEndpoint : undefined}
        >
            <input
                type="hidden"
                name="_subject"
                value="New inquiry from g2labs.pl"
            />
            <input type="hidden" name="_redirect" value={thankYouPath} />
            <input
                type="text"
                name="_gotcha"
                class="form-honeypot"
                tabindex="-1"
                autocomplete="off"
            />

            <div class="form-grid">
                <label>
                    <span>Name</span>
                    <input
                        type="text"
                        name="name"
                        autocomplete="name"
                        required
                    />
                </label>
                <label>
                    <span>Email</span>
                    <input
                        type="email"
                        name="email"
                        autocomplete="email"
                        required
                    />
                </label>
                <label>
                    <span>Company</span>
                    <input
                        type="text"
                        name="company"
                        autocomplete="organization"
                    />
                </label>
                <label>
                    <span>Product stage</span>
                    <select name="product_stage">
                        <option value="">Select stage</option>
                        {
                            productStageOptions.map((option) => (
                                <option value={option}>{option}</option>
                            ))
                        }
                    </select>
                </label>
                <label>
                    <span>What kind of help do you need?</span>
                    <select name="engagement_type">
                        <option value="">Select type</option>
                        {
                            serviceOptions.map((option) => (
                                <option value={option}>{option}</option>
                            ))
                        }
                    </select>
                </label>
                <label>
                    <span>Main area</span>
                    <select name="primary_tech_stack">
                        <option value="">Select one</option>
                        {
                            stackAreas.map((option) => (
                                <option value={option}>{option}</option>
                            ))
                        }
                    </select>
                </label>
                <label class="field-full">
                    <span>Where is the bottleneck?</span>
                    <textarea
                        name="problem"
                        rows="5"
                        placeholder="Firmware delivery, wireless integration, device-to-cloud boundary, MVP scope, tooling around the product, or something else specific."
                        required></textarea>
                </label>
                <label class="field-full">
                    <span>Relevant technical context</span>
                    <textarea
                        name="technical_context"
                        rows="4"
                        placeholder="Hardware platform, protocols, software stack around the device, compliance or reliability constraints, timeline pressure."
                    ></textarea>
                </label>
            </div>

            <div class="form-actions">
                <button
                    class="button button-primary"
                    type="submit"
                    disabled={!isFormConfigured}
                >
                    Send inquiry
                </button>
                {
                    !isFormConfigured && (
                        <p class="form-note">
                            The form is offline right now. Please email me
                            directly.
                        </p>
                    )
                }
            </div>
        </form>
    </section>

    <section class="panel panel-shell trust-section">
        <div class="section-heading compact-heading">
            <div>
                <p class="eyebrow">Company</p>
                <h2>Business details</h2>
            </div>
        </div>
        <div class="trust-grid">
            <div class="trust-item">
                <span>Company</span>
                <strong>{business.companyName}</strong>
            </div>
            <div class="trust-item">
                <span>NIP</span>
                <strong>{business.nip}</strong>
            </div>
            <div class="trust-item">
                <span>REGON</span>
                <strong>{business.regon}</strong>
            </div>
            <div class="trust-item">
                <span>Active since</span>
                <strong>{business.started}</strong>
            </div>
            <div class="trust-item">
                <span>Email</span>
                <strong
                    ><a href={`mailto:${company.email}`}>{company.email}</a
                    ></strong
                >
            </div>
            <div class="trust-item">
                <span>Country</span>
                <strong>{business.country}</strong>
            </div>
            <div class="trust-item">
                <span>Response window</span>
                <strong>{business.responseWindow}</strong>
            </div>
        </div>
        <div class="tag-row trust-tag-row">
            {business.engagementModes.map((item) => <span>{item}</span>)}
        </div>
        <p class="trust-registry-link">
            Official public entry: <a
                href={business.registryUrl}
                target="_blank"
                rel="noreferrer">{business.registryLabel}</a
            >
        </p>
    </section>

</BaseLayout>
