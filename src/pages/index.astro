---
import { getCollection } from "astro:content";
import {
    caseStudies,
    clients,
    company,
    links,
    products,
    services,
    stackAreas,
} from "../data/company";
import { herotofuEndpoint, isFormConfigured, thankYouPath } from "../lib/forms";
import BaseLayout from "../layouts/BaseLayout.astro";

const homeContactLinks = links.filter((link) =>
    ["LinkedIn", "GitHub", "Facebook"].includes(link.label),
);

const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort(
        (left, right) =>
            right.data.publishDate.getTime() - left.data.publishDate.getTime(),
    )
    .slice(0, 2);

// Client work only; the full list lives on /work.
const homeCaseStudies = caseStudies
    .filter((study) => study.client !== "G2Labs")
    .slice(0, 3);

const productPreviewMap = {
    micros: {
        src: "/microsproject.png",
        alt: "MicrOS website screenshot",
        width: 2978,
        height: 1675,
        frameClass:
            "product-screenshot-frame-compact product-screenshot-frame-micros-compact",
    },
    devtoolsforme: {
        src: "/devtoolsforme.png",
        alt: "DevToolsForMe homepage screenshot",
        width: 2266,
        height: 1721,
        frameClass: "product-screenshot-frame-compact",
    },
} as const;
const homeProducts = products.filter(
    (product) => product.slug in productPreviewMap,
);

const getPostHref = (id: string) => `/blog/${id.replace(/\.(md|mdx)$/, "")}/`;
---

<BaseLayout
    title="G2Labs | Embedded firmware for connected devices"
    description="G2Labs is the independent embedded engineering practice of Grzegorz Grzęda: Nordic nRF54 and Zephyr firmware, Thread and BLE connectivity, secure device-to-cloud integration, and field updates."
>
    <section class="hero panel">
        <div>
            <p class="eyebrow">Embedded engineering · Poland · B2B</p>
            <h1>Firmware for connected devices, from the radio to the server.</h1>
            <p class="lead">
                I'm Grzegorz Grzęda. Since 2010 I have built embedded software
                for products that ship: Nordic nRF54 and nRF52 with Zephyr,
                Thread and BLE, secure device-to-cloud communication, and field
                updates with MCUboot. G2Labs is my independent practice, working
                remotely with teams across Europe.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="#contact"
                    >Discuss a project</a
                >
                <a class="button button-secondary" href="/work">See my work</a>
            </div>
        </div>
        <div class="hero-card">
            <p>What I take on</p>
            <ul>
                <li>Firmware rescue and stabilization</li>
                <li>Thread and BLE devices on nRF54 / nRF52 with Zephyr</li>
                <li>Secure device-to-cloud links and OTA updates</li>
                <li>MVPs from prototype to production</li>
            </ul>
        </div>
    </section>

    <section class="panel panel-shell">
        <p class="eyebrow">Worked with</p>
        <div class="tag-row client-row">
            {clients.map((client) => <span>{client}</span>)}
        </div>
    </section>

    <section class="panel panel-shell">
        <div class="section-heading compact-heading">
            <div>
                <p class="eyebrow">Services</p>
                <h2>How I can help</h2>
            </div>
            <a href="/work#packages">Packages and details</a>
        </div>
        <div class="project-grid work-grid">
            {
                services.map((service) => (
                    <article class="project-card tall-card">
                        <p class="card-kicker">{service.format}</p>
                        <h3>{service.title}</h3>
                        <p>{service.description}</p>
                        <p class="service-outcome">{service.outcome}</p>
                    </article>
                ))
            }
        </div>
    </section>

    <section class="panel panel-shell">
        <div class="section-heading compact-heading">
            <div>
                <p class="eyebrow">Case studies</p>
                <h2>Selected client work</h2>
            </div>
            <a href="/work#case-studies">All work and experience</a>
        </div>
        <div class="case-study-grid case-study-row-list">
            {
                homeCaseStudies.map((study) => (
                    <article class="project-card case-study-card case-study-row-card">
                        <p class="card-kicker case-study-row-label">
                            {study.client} / {study.period}
                        </p>
                        <div class="case-study-row-content">
                            <h3>{study.title}</h3>
                            <p class="case-study-teaser">{study.context}</p>
                            <div class="tag-row stack-tags case-study-stack-tags">
                                {study.stack.map((item) => (
                                    <span>{item}</span>
                                ))}
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>

    <section class="panel panel-shell">
        <div class="section-heading compact-heading">
            <div>
                <p class="eyebrow">Open source and products</p>
                <h2>Things I build in public</h2>
            </div>
            <a href="/products">All products</a>
        </div>
        <div class="project-grid work-grid product-row-list product-row-list-home">
            {
                homeProducts.map((product) => {
                    const screenshot =
                        productPreviewMap[
                            product.slug as keyof typeof productPreviewMap
                        ];

                    return (
                        <article class="project-card stack-card tall-card product-row-card product-row-card-home">
                            <figure
                                class={`product-screenshot-frame ${screenshot.frameClass}`}
                            >
                                <img
                                    src={screenshot.src}
                                    alt={screenshot.alt}
                                    loading="lazy"
                                    width={screenshot.width}
                                    height={screenshot.height}
                                />
                            </figure>
                            <div class="product-row-content product-row-content-home">
                                <p class="card-kicker">{product.label}</p>
                                <h3>{product.name}</h3>
                                <p>{product.summary}</p>
                                <div class="tag-row stack-tags">
                                    {product.categories
                                        .slice(0, 5)
                                        .map((category) => (
                                            <span>{category}</span>
                                        ))}
                                </div>
                                <div class="product-links">
                                    <a
                                        class="button button-primary"
                                        href={product.href}
                                        target="_blank"
                                        rel="noreferrer"
                                    >
                                        Open {product.name}
                                    </a>
                                    <a
                                        class="button button-secondary"
                                        href={`/products/${product.slug}`}
                                    >
                                        More details
                                    </a>
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </section>

    <section class="panel panel-shell about-strip">
        <div class="section-heading compact-heading">
            <div>
                <p class="eyebrow">About</p>
                <h2>One engineer for the device and the software around it</h2>
            </div>
        </div>
        <div class="about-studio-grid">
            <figure class="about-portrait">
                <img
                    src="/me-2.jpeg"
                    alt="Grzegorz Grzęda"
                    loading="lazy"
                    width="896"
                    height="1088"
                />
            </figure>
            <div class="about-copy">
                <p>{company.longBio}</p>
                <p>
                    G2Labs stays intentionally small: you work directly with the
                    engineer who writes the code, so decisions stay explicit and
                    communication stays short. The full timeline, education, and
                    publications are on the <a href="/work">work page</a>.
                </p>
            </div>
        </div>
    </section>

    {
        blogPosts.length > 0 && (
            <section class="panel panel-shell">
                <div class="section-heading compact-heading">
                    <div>
                        <p class="eyebrow">Writing</p>
                        <h2>Latest posts</h2>
                    </div>
                    <a href="/blog">All posts</a>
                </div>
                <div class="blog-grid">
                    {blogPosts.map((post) => (
                        <article class="post-card panel">
                            <p>
                                {post.data.publishDate.toLocaleDateString(
                                    "en-US",
                                    {
                                        month: "short",
                                        day: "numeric",
                                        year: "numeric",
                                    },
                                )}
                            </p>
                            <h3>
                                <a href={getPostHref(post.id)}>
                                    {post.data.title}
                                </a>
                            </h3>
                            <p>{post.data.excerpt}</p>
                        </article>
                    ))}
                </div>
            </section>
        )
    }

    <section class="panel panel-shell home-contact-strip" id="contact">
        <div class="home-contact-copy">
            <p class="eyebrow">Contact</p>
            <h2>Tell me what is blocking the product.</h2>
            <p>
                Write to <a
                    class="contact-email"
                    href={`mailto:${company.email}`}>{company.email}</a
                > or use the form. I usually reply within 2 business days.
            </p>
            <div class="home-contact-links">
                {
                    homeContactLinks.map((link) => (
                        <a href={link.href} target="_blank" rel="noreferrer">
                            <span>{link.label}</span>
                            <span>Profile</span>
                        </a>
                    ))
                }
            </div>
        </div>
        <form
            class="contact-form compact-contact-form"
            method="POST"
            action={isFormConfigured ? herotofuEndpoint : undefined}
        >
            <input
                type="hidden"
                name="_subject"
                value="Homepage inquiry from g2labs.pl"
            />
            <input type="hidden" name="_redirect" value={thankYouPath} />
            <input
                type="text"
                name="_gotcha"
                class="form-honeypot"
                tabindex="-1"
                autocomplete="off"
            />

            <div class="form-grid compact-form-grid">
                <label>
                    <span>Name</span>
                    <input
                        type="text"
                        name="name"
                        autocomplete="name"
                        required
                    />
                </label>
                <label>
                    <span>Email</span>
                    <input
                        type="email"
                        name="email"
                        autocomplete="email"
                        required
                    />
                </label>
                <label class="field-full">
                    <span>Main area</span>
                    <select name="primary_tech_stack">
                        <option value="">Select one</option>
                        {
                            stackAreas.map((option) => (
                                <option value={option}>{option}</option>
                            ))
                        }
                    </select>
                </label>
                <label class="field-full">
                    <span>What do you need help with?</span>
                    <textarea
                        name="problem"
                        rows="4"
                        placeholder="Product stage, hardware, and what is currently blocking you."
                        required></textarea>
                </label>
            </div>

            <div class="form-actions compact-form-actions">
                <button
                    class="button button-primary"
                    type="submit"
                    disabled={!isFormConfigured}
                >
                    Send inquiry
                </button>
                {
                    !isFormConfigured && (
                        <p class="form-note">
                            The form is offline right now. Please email me
                            directly.
                        </p>
                    )
                }
            </div>
        </form>
    </section>
</BaseLayout>
