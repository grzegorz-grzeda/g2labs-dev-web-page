---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absoluteUrl, organizationId, personId, postPath } from "../../lib/seo";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);

    return posts.map((post) => ({
        params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = absoluteUrl(postPath(post.id));
const blogPosting = {
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    headline: post.data.title,
    description: post.data.excerpt,
    datePublished: post.data.publishDate.toISOString(),
    inLanguage: "en",
    keywords: post.data.tags.join(", "),
    url,
    mainEntityOfPage: url,
    image: absoluteUrl("/me-2.jpeg"),
    author: { "@id": personId },
    publisher: { "@id": organizationId },
};
---

<BaseLayout
    title={`${post.data.title} | G2Labs`}
    description={post.data.excerpt}
    ogType="article"
    publishedTime={post.data.publishDate}
    structuredData={[blogPosting]}
>
    <article class="post-shell panel narrow prose-shell">
        <p class="eyebrow">
            {
                post.data.publishDate.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                })
            }
        </p>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.excerpt}</p>
        <div class="tag-row">
            {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <div class="prose">
            <Content />
        </div>
    </article>
</BaseLayout>
